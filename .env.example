# Swiftgrocers POS — environment
#
# Copy to `.env` and fill in. `.env` is git-ignored and must stay that way.
# The online store in ../swiftgrocers-main points at the SAME database.
# See docs/DATABASE.md.

# ── The database ────────────────────────────────────────────────────────────
#
# TWO strings, and the difference is the whole security model.
#
# The application connects as `swiftgrocers_app`: a NON-superuser, non-owner
# role that row-level security applies to. Point this at the owner and every
# policy in the schema silently stops applying (SPEC §8).
DATABASE_URL="postgresql://swiftgrocers_app:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/swiftgrocers?sslmode=require"

# Migrations and the seed only. The owner role, which bypasses policies.
# Never used by the running application.
DIRECT_DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/swiftgrocers?sslmode=require"

# ── Identity: Neon Auth (Stack Auth) ────────────────────────────────────────
NEXT_PUBLIC_STACK_PROJECT_ID=""
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=""
STACK_SECRET_SERVER_KEY=""

# ── Which data layer the screens run against ────────────────────────────────
#
# `mock`   in-memory fixtures (the default while the database is empty)
# `prisma` the real Neon database
DATA_SOURCE="mock"
